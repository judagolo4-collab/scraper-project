# =============================================================================
# VARIABLES DE ENTORNO - PLANTILLA
# =============================================================================
# 📋 Copia este archivo a .env y configura tus valores
# Comando: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 🤖 GEMINI AI (REQUERIDO)
# -----------------------------------------------------------------------------
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# -----------------------------------------------------------------------------
# 🗄️ POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_MULTIPLE_DATABASES=proyectos_ley,scraper_metadata

# -----------------------------------------------------------------------------
# 🔴 REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# ☁️ S3 / LOCALSTACK
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566

# -----------------------------------------------------------------------------
# 🌐 SCRAPER API (FastAPI)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 🌊 AIRFLOW
# -----------------------------------------------------------------------------
# Usuario admin de Airflow UI
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin

# Conexiones de Airflow
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Base de datos de Airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow?client_encoding=utf8

# Celery
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres:5432/airflow?client_encoding=utf8
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0

# API Auth
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true

# Conexiones customizadas
AIRFLOW_CONN_SCRAPER_API=http://scraper-api:8000
AIRFLOW_CONN_POSTGRES_PROYECTOS=postgresql://airflow:airflow@postgres:5432/proyectos_ley

# -----------------------------------------------------------------------------
# 🛠️ DESARROLLO LOCAL (Opcional - Solo para desarrollo fuera de Docker)
# -----------------------------------------------------------------------------
# Chrome y ChromeDriver paths (ajusta según tu sistema operativo)
# MacOS:
CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMEDRIVER_PATH=/opt/homebrew/bin/chromedriver

# Linux:
# CHROME_BIN=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Windows:
# CHROME_BIN=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# CHROMEDRIVER_PATH=C:\\chromedriver\\chromedriver.exe

SELENIUM_HEADLESS=true
DATABASE_URL=postgresql://airflow:airflow@localhost:5432/proyectos_ley
